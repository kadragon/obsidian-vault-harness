{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-todo-due-date.py\"",
            "statusMessage": "할일 마감일 검사 중..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-tags.sh\"",
            "statusMessage": "태그 검증 중..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-template.py\"",
            "statusMessage": "템플릿 검사 중..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-nested-delegation.py\"",
            "statusMessage": "중첩 위임 검사 중..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-bare-python.py\"",
            "statusMessage": "맨 python 호출 검사 중..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-folder-rules.py\"",
            "statusMessage": "폴더 규칙 검사 중..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "humanize-korean@im-not-ai": true
  }
}
