{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync-check.py\"",
            "timeout": 30,
            "statusMessage": "원격 동기화 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-write.py\"",
            "statusMessage": "노트·하네스 검사 중..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-markdownlint.py\"",
            "timeout": 60,
            "statusMessage": "마크다운 lint 검사 중..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "humanize-korean@im-not-ai": false,
    "typescript-lsp@claude-plugins-official": false
  }
}
