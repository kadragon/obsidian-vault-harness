{
  "enabledPlugins": {
    "serena@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check-todo-due-date.py",
            "statusMessage": "할일 마감일 검사 중..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-tags.sh",
            "statusMessage": "태그 검증 중..."
          }
        ]
      }
    ]
  }
}
